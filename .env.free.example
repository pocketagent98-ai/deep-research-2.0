# =============================================================================
#  FREE Deep Research 2.0 — .env template
#  Isko copy karo:  cp .env.free.example .env
#  aur apni keys paste karo jahan YOUR_..._KEY likha hai.
#
#  !! KABHI BHI keys is repo me commit mat karna — repo PUBLIC hai !!
#  (`.env` pehle se hi .gitignore me hai, isliye .env safe rehti hai)
# =============================================================================

# -----------------------------------------------------------------------------
# OPTION A (default) — z.ai : 100% FREE models
#   - glm-4.5-flash  (free, reasoning + agents)
#   - glm-4.7-flash  (free, naya version)
# -----------------------------------------------------------------------------
OPENAI_BASE_URL=https://api.z.ai/api/paas/v4/
OPENAI_API_KEY=YOUR_ZAI_API_KEY_HERE
FAST_LLM=openai:glm-4.5-flash
SMART_LLM=openai:glm-4.5-flash
STRATEGIC_LLM=openai:glm-4.5-flash
# Naya free model try karna ho to upar glm-4.5-flash ki jagah glm-4.7-flash likho

# -----------------------------------------------------------------------------
# OPTION B — NaraRouter : freemium, free tokens har roz reset
#   (Option A wali 3 lines + OPENAI_BASE_URL/API_KEY comment karo,
#    aur ye uncomment karo)
# -----------------------------------------------------------------------------
# OPENAI_BASE_URL=https://router.bynara.id/v1
# OPENAI_API_KEY=YOUR_NARAROUTER_API_KEY_HERE
# FAST_LLM=openai:auto/bynara
# SMART_LLM=openai:auto/bynara
# STRATEGIC_LLM=openai:auto/bynara

# -----------------------------------------------------------------------------
# Embeddings — FREE & local (koi API key nahi chahiye)
# -----------------------------------------------------------------------------
EMBEDDING=huggingface:sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Search (web search) — FREE retriever, bina API key
# -----------------------------------------------------------------------------
RETRIEVER=duckduckgo
# Zyada quality chahiye to Tavily ka free plan (1000 credits/month):
# RETRIEVER=tavily
# TAVILY_API_KEY=YOUR_TAVILY_KEY_HERE

# -----------------------------------------------------------------------------
# Scraping agents — 12 parallel web scrapers
# -----------------------------------------------------------------------------
SCRAPER=bs
MAX_SCRAPER_WORKERS=12
SCRAPER_RATE_LIMIT_DELAY=1.0

# -----------------------------------------------------------------------------
# DEEP RESEARCH — gehrai + lambi research (hours tak)
#   BREADTH = har level par kitne sub-queries
#   DEPTH   = kitne level tak andar jaana
# -----------------------------------------------------------------------------
DEEP_RESEARCH_BREADTH=8
DEEP_RESEARCH_DEPTH=3
DEEP_RESEARCH_CONCURRENCY=8

# -----------------------------------------------------------------------------
# Token limits (flash models ke liye tuned)
# -----------------------------------------------------------------------------
FAST_TOKEN_LIMIT=8000
SMART_TOKEN_LIMIT=16000
STRATEGIC_TOKEN_LIMIT=16000

# -----------------------------------------------------------------------------
# Report language (default english; hindi report chahiye to badlo)
# -----------------------------------------------------------------------------
LANGUAGE=english
# LANGUAGE=hindi
